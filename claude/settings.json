{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(tree *)",
      "Bash(jq *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git show *)",
      "Bash(mise current *)",
      "Bash(mise current)",
      "Bash(golangci-lint run *)",
      "Bash(go vet *)",
      "Bash(pnpm test *)",
      "Bash(npm test *)",
      "Bash(hunk session *)",
      "Bash(hunk daemon status)",
      "Bash(hunk markup *)",
      "Bash(hunk skill *)",
      "Bash(herdr pane *)",
      "Bash(herdr tab *)",
      "Bash(herdr agent *)",
      "Bash(herdr workspace list)",
      "Bash(make *)",
      "Read(~/work/obsidian_git/**)",
      "Read(~/dotfiles/**)",
      "Edit(~/work/obsidian_git/01_projects/**)",
      "Edit(~/work/obsidian_git/02_inbox/**)",
      "Edit(~/work/obsidian_git/assets/**)",
      "Edit(~/work/obsidian_git/README.md)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push *-f*)",
      "Bash(git push *--force*)",
      "Bash(age -d *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(hunk session comment clear *--all*)",
      "Bash(hunk session comment clear *--include-user*)",
      "Bash(herdr server stop *)",
      "Bash(herdr server stop)",
      "Read(~/.ssh/**)",
      "Read(~/.config/mise/dotfiles-age.txt)",
      "Read(~/dotfiles/mise/dotfiles-age.txt)",
      "Edit(~/work/obsidian_git/.agents/**)",
      "Edit(~/.gemini/**)",
      "Edit(~/.claude/**)",
      "Edit(~/dotfiles/gemini/**)",
      "Edit(~/dotfiles/claude/**)",
      "Edit(**/.git/**)",
      "Edit(/etc/**)",
      "Edit(/private/etc/**)",
      "Edit(/Library/**)",
      "Edit(/Volumes/**)",
      "Edit(/System/**)"
    ],
    "ask": [
      "Bash(rm -r *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reflog *)",
      "Bash(git reset --soft *)",
      "Bash(git switch *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(npm install *)",
      "Bash(go build *)",
      "Bash(go get *)",
      "Bash(composer *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(herdr *)",
      "Bash(terraform *)",
      "Bash(make clean *)",
      "Edit(~/work/obsidian_git/AGENT.md)",
      "Edit(~/work/obsidian_git/01_projects/AI憲法策定/憲法_草案.md)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/daiki-fukushima/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark"
}
