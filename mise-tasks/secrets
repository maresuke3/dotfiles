#!/usr/bin/env bash
#MISE description="Decrypt secret files to home directory"
#MISE wait_for=["link", "tools"]
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

echo -e "\033[1;36m[INFO]\033[0m Decrypting secret files..."

AGE_KEY="$HOME/.config/mise/dotfiles-age.txt"

if [ ! -f "$AGE_KEY" ]; then
    echo -e "  \033[1;33m[WARN]\033[0m Age identity file not found at $AGE_KEY"
    echo -e "  \033[1;33m[WARN]\033[0m Skipping secret file decryption."
    exit 0
fi

# Decrypt .gitconfig_work
if [ -f "$HOME/dotfiles/git/.gitconfig_work.age" ]; then
    age -d -i "$AGE_KEY" -o "$HOME/.gitconfig_work" "$HOME/dotfiles/git/.gitconfig_work.age"
    chmod 600 "$HOME/.gitconfig_work"
    echo -e "  \033[1;32m[OK]\033[0m Decrypted ~/.gitconfig_work"
fi

# Decrypt .gitconfig_global
if [ -f "$HOME/dotfiles/git/.gitconfig_global.age" ]; then
    age -d -i "$AGE_KEY" -o "$HOME/.gitconfig_global" "$HOME/dotfiles/git/.gitconfig_global.age"
    chmod 600 "$HOME/.gitconfig_global"
    echo -e "  \033[1;32m[OK]\033[0m Decrypted ~/.gitconfig_global"
fi

# Decrypt .gitconfig
if [ -f "$HOME/dotfiles/git/.gitconfig.age" ]; then
    age -d -i "$AGE_KEY" -o "$HOME/.gitconfig" "$HOME/dotfiles/git/.gitconfig.age"
    chmod 600 "$HOME/.gitconfig"
    echo -e "  \033[1;32m[OK]\033[0m Decrypted ~/.gitconfig"
fi
