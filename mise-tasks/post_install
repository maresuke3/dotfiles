#!/usr/bin/env bash
#MISE description="Run post-installation steps (sheldon, npm globals, directories)"
#MISE wait_for=["link", "tools", "secrets"]
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

echo -e "\033[1;36m[INFO]\033[0m Creating working directories..."
mkdir -p ~/work/{individual,prototype}
echo -e "  \033[1;32m[OK]\033[0m Working directories created."

echo -e "\n\033[1;36m[INFO]\033[0m Updating sheldon plugins..."
if command -v sheldon &>/dev/null; then
    SHELDON_BIN="$(mise which sheldon 2>/dev/null || command -v sheldon)"
    # Run with clean HOME so libgit2 ignores ~/.gitconfig url.git@github.com:.insteadOf and uses HTTPS
    tmp_home=$(mktemp -d)
    SHELDON_CONFIG_DIR="$HOME/.config/sheldon" \
    SHELDON_DATA_DIR="$HOME/.local/share/sheldon" \
    HOME="$tmp_home" \
    "$SHELDON_BIN" lock --update
    rm -rf "$tmp_home"
    echo -e "  \033[1;32m[OK]\033[0m Sheldon plugins updated."
else
    echo -e "  \033[1;33m[SKIP]\033[0m Sheldon is not installed yet."
fi

echo -e "\n\033[1;36m[INFO]\033[0m Installing global CLI tools..."
if command -v npm &>/dev/null; then
    if ! command -v gemini &>/dev/null; then
        npm install -g @google/gemini-cli
        echo -e "  \033[1;32m[OK]\033[0m gemini-cli installed."
    else
        echo -e "  \033[1;33m[SKIP]\033[0m gemini-cli already installed."
    fi
else
    echo -e "  \033[1;31m[ERROR]\033[0m npm not found. Make sure node is installed via mise."
fi

if command -v uv &>/dev/null; then
    if ! command -v serena &>/dev/null; then
        # Serena MCP server (semantic code tools); `serena init` creates ~/.serena/serena_config.yml
        uv tool install -p 3.13 serena-agent
        serena init
        echo -e "  \033[1;32m[OK]\033[0m serena installed."
    else
        echo -e "  \033[1;33m[SKIP]\033[0m serena already installed."
    fi
else
    echo -e "  \033[1;31m[ERROR]\033[0m uv not found. Make sure uv is installed via mise."
fi

if ! command -v claude &>/dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
    echo -e "  \033[1;32m[OK]\033[0m claude-code installed."
else
    echo -e "  \033[1;33m[SKIP]\033[0m claude-code already installed."
fi

echo -e "\n\033[1;36m[INFO]\033[0m Installing & syncing AI Agent plugins..."
CLAUDE_PLUGINS=(
    "figma@claude-plugins-official"
)

if command -v claude &>/dev/null; then
    for plugin in "${CLAUDE_PLUGINS[@]}"; do
        claude plugin install "$plugin"
        echo -e "  \033[1;32m[OK]\033[0m claude plugin installed: $plugin"
    done
else
    echo -e "  \033[1;33m[SKIP]\033[0m claude not found, skipping plugin install."
fi

echo -e "\n\033[1;36m[INFO]\033[0m Registering Claude Code MCP servers (user scope)..."
# Remote HTTP MCP servers managed by Claude Code config (not claude.ai connectors).
# Format: "<name> <url> [oauth_client_id] [oauth_callback_port]".
# OAuth is done per machine via `/mcp` in a Claude Code session.
# client_id is needed for servers without Dynamic Client Registration (e.g. Slack).
# It is a public identifier, not a secret.
CLAUDE_HTTP_MCP_SERVERS=(
    "atlassian https://mcp.atlassian.com/v2/mcp"
    # Slack-published client ID (same as slackapi/slack-skills-plugin .mcp.json)
    "slack https://mcp.slack.com/mcp 1601185624273.8899143856786 3118"
    "notion https://mcp.notion.com/mcp"
)

if command -v claude &>/dev/null; then
    for entry in "${CLAUDE_HTTP_MCP_SERVERS[@]}"; do
        read -r name url client_id callback_port <<<"$entry"
        if claude mcp get "$name" &>/dev/null; then
            echo -e "  \033[1;33m[SKIP]\033[0m claude mcp already registered: $name"
        else
            oauth_args=()
            [[ -n "${client_id:-}" ]] && oauth_args+=(--client-id "$client_id")
            [[ -n "${callback_port:-}" ]] && oauth_args+=(--callback-port "$callback_port")
            # ${arr[@]+...} keeps bash 3.2 (macOS default) happy with an empty array under `set -u`
            claude mcp add --transport http --scope user ${oauth_args[@]+"${oauth_args[@]}"} "$name" "$url"
            echo -e "  \033[1;32m[OK]\033[0m claude mcp registered: $name"
        fi
    done
fi

MISE_SHIMS="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"

# GitHub remote MCP. No PAT is stored: headersHelper fetches the gh CLI token on each connect.
if command -v claude &>/dev/null; then
    if claude mcp get github &>/dev/null; then
        echo -e "  \033[1;33m[SKIP]\033[0m claude mcp already registered: github"
    else
        gh_helper="printf '{\"Authorization\":\"Bearer %s\"}' \"\$($MISE_SHIMS/gh auth token)\""
        claude mcp add-json --scope user github \
            "$(jq -n --arg h "$gh_helper" '{type: "http", url: "https://api.githubcopilot.com/mcp/", headersHelper: $h}')"
        echo -e "  \033[1;32m[OK]\033[0m claude mcp registered: github (requires \`gh auth login\`)"
    fi
fi

# Local stdio MCP servers.
# Format: "<name> <command> [args...]" (args must not contain spaces).
# The command is resolved via PATH (mise shims and ~/.local/bin are first, see top of file).
# Never pass tokens with `-e` here: `claude mcp add -e` writes them to ~/.claude.json in plaintext.
# Secrets are inherited from the environment instead (age-encrypted in mise/conf.d/env.toml).
CLAUDE_STDIO_MCP_SERVERS=(
    # Requires CHATWORK_API_TOKEN:
    #   read -rs 'T?Chatwork API token: ' && mise set --path ~/dotfiles/mise/conf.d/env.toml --age-encrypt CHATWORK_API_TOKEN="$T"; unset T
    "chatwork npx -y @chatwork/mcp-server"
    "chrome-devtools npx -y chrome-devtools-mcp@latest --no-usage-statistics --no-performance-crux"
    "playwright npx -y @playwright/mcp@latest"
    "serena serena start-mcp-server --context claude-code --project-from-cwd"
)

if command -v claude &>/dev/null; then
    for entry in "${CLAUDE_STDIO_MCP_SERVERS[@]}"; do
        read -r name cmd args <<<"$entry"
        if claude mcp get "$name" &>/dev/null; then
            echo -e "  \033[1;33m[SKIP]\033[0m claude mcp already registered: $name"
            continue
        fi
        if ! cmd_path="$(command -v "$cmd")"; then
            echo -e "  \033[1;31m[ERROR]\033[0m $cmd not found, skipping MCP registration: $name"
            continue
        fi
        # shellcheck disable=SC2206 # intentional word splitting of args
        arg_list=($args)
        # The server name must come before -e: -e is variadic and would swallow it.
        # PATH lets npx shims find node even when Claude Code is started outside a mise-activated shell.
        claude mcp add "$name" --scope user -e "PATH=$MISE_SHIMS:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" \
            -- "$cmd_path" ${arg_list[@]+"${arg_list[@]}"}
        echo -e "  \033[1;32m[OK]\033[0m claude mcp registered: $name"
    done
else
    echo -e "  \033[1;33m[SKIP]\033[0m claude not found, skipping MCP registration."
fi

if command -v agy &>/dev/null; then
    agy plugin import claude
    echo -e "  \033[1;32m[OK]\033[0m Imported Claude plugins into Antigravity (agy)."
else
    echo -e "  \033[1;33m[SKIP]\033[0m agy not found, skipping plugin import."
fi

echo -e "\n\033[1;32m[OK]\033[0m Post-installation completed!"
