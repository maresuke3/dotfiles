codex_mcp_unchanged() {
    local current_json="$1"
    local name="$2"
    local mode="$3"
    local desired_spec="$4"
    [ -n "$current_json" ] || return 1
    local current_spec
    if [ "$mode" = "http" ]; then
        current_spec="$(jq -cS --arg n "$name" '
            if type == "array" then .[] | select(.name == $n) | {type: .transport.type, url: .transport.url}
            else empty end
        ' <<<"$current_json" 2>/dev/null || true)"
    else
        current_spec="$(jq -cS --arg n "$name" '
            if type == "array" then .[] | select(.name == $n) | {type: .transport.type, command: .transport.command, args: (.transport.args // []), env: (.transport.env // {})}
            else empty end
        ' <<<"$current_json" 2>/dev/null || true)"
    fi
    [ -n "$current_spec" ] && [ "$current_spec" = "$desired_spec" ]
}

sync_codex_mcp() {
    echo -e "\n\033[1;36m[INFO]\033[0m Syncing Codex MCP servers..."
    local desired current_json existing
    desired="$(desired_mcp_names codex)"
    current_json="$(run_with_timeout "$AI_SYNC_TIMEOUT" codex mcp list --json 2>/dev/null || true)"
    existing="$(jq -r '
        if type == "array" then .[] | (.name // empty)
        elif type == "object" then (.mcpServers // .servers // .) | keys[]
        else empty end
    ' <<<"$current_json" 2>/dev/null || true)"

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if ! in_list "$name" "$desired"; then
            if run_cmd "codex mcp remove: $name" codex mcp remove "$name"; then
                echo -e "  \033[1;31m[DEL]\033[0m  codex mcp removed: $name"
            fi
        fi
    done <<<"$existing"

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name url client_id desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        url="$(jq -r '.url' <<<"$entry")"
        client_id="$(jq -r '.oauth.client_id // empty' <<<"$entry")"
        desired_spec="$(jq -cnS --arg url "$url" '{type: "streamable_http", url: $url}')"

        if codex_mcp_unchanged "$current_json" "$name" "http" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m codex mcp (http): $name (unchanged)"
            continue
        fi

        if in_list "$name" "$existing"; then
            run_with_timeout "$AI_SYNC_TIMEOUT" codex mcp remove "$name" &>/dev/null || true
        fi

        local -a oauth_args=()
        [ -n "$client_id" ] && oauth_args+=(--oauth-client-id "$client_id")
        if run_cmd "codex mcp (http): $name" codex mcp add "$name" --url "$url" ${oauth_args[@]+"${oauth_args[@]}"}; then
            echo -e "  \033[1;32m[SYNC]\033[0m codex mcp (http): $name"
        fi
    done < <(jq -c '.mcp.http // [] | .[] | select((.agents // []) | index("codex"))' "$MANIFEST")

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name cmd cmd_path env_json desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        cmd="$(jq -r '.command' <<<"$entry")"
        env_json="$(jq -c '.env // {}' <<<"$entry")"

        if ! cmd_path="$(command -v "$cmd")"; then
            echo -e "  \033[1;31m[ERROR]\033[0m $cmd not found, skipping codex mcp: $name" >&2
            FAIL_COUNT=$((FAIL_COUNT + 1))
            continue
        fi

        desired_spec="$(build_stdio_spec "stdio" "$cmd_path" "$(jq -c '.args // []' <<<"$entry")" "$env_json")"
        if codex_mcp_unchanged "$current_json" "$name" "stdio" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m codex mcp (stdio): $name (unchanged)"
            continue
        fi

        local -a env_args=() arg_list=()
        while IFS= read -r -d '' item; do env_args+=("$item"); done < <(build_env_args "--env" "$env_json")
        while IFS= read -r a; do [ -n "$a" ] && arg_list+=("$a"); done < <(jq -r '.args // [] | .[]' <<<"$entry")

        if in_list "$name" "$existing"; then
            run_with_timeout "$AI_SYNC_TIMEOUT" codex mcp remove "$name" &>/dev/null || true
        fi
        if run_cmd "codex mcp (stdio): $name" codex mcp add "$name" "${env_args[@]}" -- "$cmd_path" ${arg_list[@]+"${arg_list[@]}"}; then
            echo -e "  \033[1;32m[SYNC]\033[0m codex mcp (stdio): $name"
        fi
    done < <(jq -c '.mcp.stdio // [] | .[] | select((.agents // []) | index("codex"))' "$MANIFEST")
}

# =============================================================================
# Main (run agents in parallel, buffer output per agent)
# =============================================================================
run_agent_sync() {
    local agent="$1"
    local log_file="$2"
    FAIL_COUNT=0
    if command -v "$agent" &>/dev/null; then
        : >"$log_file"
        [ "$agent" = "codex" ] && sync_codex_config >>"$log_file" 2>&1
        "sync_${agent}_plugins" >>"$log_file" 2>&1
        "sync_${agent}_mcp" >>"$log_file" 2>&1
    else
        echo -e "\n\033[1;33m[SKIP]\033[0m $agent not found, skipping sync." >"$log_file" 2>&1
    fi
    return "$FAIL_COUNT"
}

tmp_log_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_log_dir"' EXIT

AGENTS=(claude agy codex)
pids=()
for agent in "${AGENTS[@]}"; do
    run_agent_sync "$agent" "$tmp_log_dir/$agent.log" &
    pids+=($!)
done

total_failures=0
for i in "${!AGENTS[@]}"; do
    agent="${AGENTS[$i]}"
    rc=0
    wait "${pids[$i]}" || rc=$?
    cat "$tmp_log_dir/$agent.log"
    total_failures=$((total_failures + rc))
done

if [ "$total_failures" -gt 0 ]; then
    echo -e "\n\033[1;33m[WARN]\033[0m AI sync finished with $total_failures failed/timed-out operation(s)." >&2
    exit 1
fi

echo -e "\n\033[1;32m[OK]\033[0m AI sync completed!"
