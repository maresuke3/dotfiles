#!/usr/bin/env bash
#MISE description="Sync MCP servers and plugins across claude, agy, and codex from ai/ai-sync.json"
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

DRY_RUN=false
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY_RUN=true ;;
        *) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

MANIFEST="${AI_SYNC_MANIFEST:-$HOME/dotfiles/ai/ai-sync.json}"
AI_SYNC_TIMEOUT="${AI_SYNC_TIMEOUT:-20}"
MISE_SHIMS="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
RUNTIME_PATH="$MISE_SHIMS:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
FAIL_COUNT=0

if ! command -v jq &>/dev/null; then
    echo -e "\033[1;31m[ERROR]\033[0m jq is required for ai-sync." >&2
    exit 1
fi

if [ ! -f "$MANIFEST" ]; then
    echo -e "\033[1;31m[ERROR]\033[0m Manifest not found: $MANIFEST" >&2
    exit 1
fi

run_with_timeout() {
    local timeout_sec="$1"
    shift
    local cmd_pid watchdog_pid rc=0

    "$@" </dev/null &
    cmd_pid=$!

    (
        sleep "$timeout_sec"
        if kill -0 "$cmd_pid" 2>/dev/null; then
            kill -TERM "$cmd_pid" 2>/dev/null || true
            sleep 2
            kill -KILL "$cmd_pid" 2>/dev/null || true
        fi
    ) &
    watchdog_pid=$!

    wait "$cmd_pid" || rc=$?
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true
    return "$rc"
}

run_cmd() {
    local label="$1"
    shift
    if $DRY_RUN; then
        echo -e "  \033[1;33m[DRY-RUN]\033[0m $*"
        return 0
    fi
    local rc=0
    run_with_timeout "$AI_SYNC_TIMEOUT" "$@" || rc=$?
    if [ "$rc" -eq 0 ]; then
        return 0
    elif [ "$rc" -eq 143 ] || [ "$rc" -eq 137 ]; then
        echo -e "  \033[1;31m[TIMEOUT]\033[0m ${label} (${AI_SYNC_TIMEOUT}s)" >&2
    else
        echo -e "  \033[1;31m[ERROR]\033[0m   ${label} (exit $rc)" >&2
    fi
    FAIL_COUNT=$((FAIL_COUNT + 1))
    return 1
}

in_list() {
    local needle="$1"
    local haystack="$2"
    [ -n "$haystack" ] && grep -qxF "$needle" <<<"$haystack"
}

desired_mcp_names() {
    local agent="$1"
    jq -r --arg agent "$agent" '
        [(.mcp.http // [])[], (.mcp.stdio // [])[]]
        | map(select((.agents // []) | index($agent)))
        | .[].name
    ' "$MANIFEST"
}

# Build normalized stdio spec JSON for diff comparison
build_stdio_spec() {
    local type_name="$1"
    local cmd_path="$2"
    local args_json="$3"
    local env_json="$4"
    jq -cnS \
        --arg type "$type_name" \
        --arg cmd "$cmd_path" \
        --arg path "$RUNTIME_PATH" \
        --arg home "$HOME" \
        --argjson args "$args_json" \
        --argjson env "$env_json" '
        (if $type != "" then {type: $type} else {} end) + {
            command: $cmd,
            args: $args,
            env: ({PATH: $path} + ($env | with_entries(.value |= gsub("__HOME__"; $home))))
        }
    '
}

# Build -e KEY=VALUE (or --env KEY=VALUE) args for stdio MCP servers
build_env_args() {
    local flag="$1"
    local env_json="$2"
    local -a args=("$flag" "PATH=$RUNTIME_PATH")
    while IFS= read -r kv; do
        [ -z "$kv" ] && continue
        kv="${kv//__HOME__/$HOME}"
        args+=("$flag" "$kv")
    done < <(jq -r 'to_entries | .[] | "\(.key)=\(.value)"' <<<"$env_json")
    printf '%s\0' "${args[@]}"
}

# =============================================================================
# Claude Code
# =============================================================================
sync_claude_plugins() {
    echo -e "\n\033[1;36m[INFO]\033[0m Syncing Claude Code plugins..."
    local existing_mp
    existing_mp="$(run_with_timeout "$AI_SYNC_TIMEOUT" claude plugin marketplace list 2>/dev/null || true)"

    while IFS= read -r mp; do
        [ -z "$mp" ] && continue
        local mp_name mp_source
        mp_name="$(jq -r '.name' <<<"$mp")"
        mp_source="$(jq -r '.source' <<<"$mp")"
        if grep -qF "$mp_name" <<<"$existing_mp"; then
            echo -e "  \033[1;33m[SKIP]\033[0m claude marketplace already registered: $mp_name"
        elif run_cmd "claude marketplace: $mp_name" claude plugin marketplace add "$mp_source"; then
            echo -e "  \033[1;32m[ADD]\033[0m  claude marketplace: $mp_name ($mp_source)"
        fi
    done < <(jq -c '.plugins.claude.marketplaces // [] | .[]' "$MANIFEST")

    local desired existing
    desired="$(jq -r '.plugins.claude.install // [] | .[]' "$MANIFEST")"
    existing="$(run_with_timeout "$AI_SYNC_TIMEOUT" claude plugin list --json 2>/dev/null | jq -r '
        if type == "array" then .[] | (.id // .name // empty)
        elif type == "object" then (.plugins // [])[] | (.id // .name // empty)
        else empty end
    ' 2>/dev/null || true)"

    while IFS= read -r plugin; do
        [ -z "$plugin" ] && continue
        if ! in_list "$plugin" "$desired"; then
            if run_cmd "claude plugin uninstall: $plugin" claude plugin uninstall "$plugin"; then
                echo -e "  \033[1;31m[DEL]\033[0m  claude plugin uninstalled: $plugin"
            fi
        fi
    done <<<"$existing"

    while IFS= read -r plugin; do
        [ -z "$plugin" ] && continue
        if in_list "$plugin" "$existing"; then
            if run_cmd "claude plugin update: $plugin" claude plugin update "$plugin"; then
                echo -e "  \033[1;32m[UPD]\033[0m  claude plugin updated: $plugin"
            fi
        elif run_cmd "claude plugin install: $plugin" claude plugin install "$plugin"; then
            echo -e "  \033[1;32m[ADD]\033[0m  claude plugin installed: $plugin"
        fi
    done <<<"$desired"
}

claude_mcp_unchanged() {
    local claude_cfg="$1"
    local name="$2"
    local desired_spec="$3"
    [ -f "$claude_cfg" ] || return 1
    local current_spec
    current_spec="$(jq -cS --arg n "$name" '.mcpServers[$n] // empty' "$claude_cfg" 2>/dev/null || true)"
    [ -n "$current_spec" ] && [ "$current_spec" = "$desired_spec" ]
}

sync_claude_mcp() {
    echo -e "\n\033[1;36m[INFO]\033[0m Syncing Claude Code MCP servers..."
    local desired existing claude_cfg
    desired="$(desired_mcp_names claude)"
    claude_cfg="$HOME/.claude.json"
    if [ -f "$claude_cfg" ]; then
        existing="$(jq -r '.mcpServers // {} | keys[]' "$claude_cfg" 2>/dev/null || true)"
    else
        existing=""
    fi

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if ! in_list "$name" "$desired"; then
            if run_cmd "claude mcp remove: $name" claude mcp remove --scope user "$name"; then
                echo -e "  \033[1;31m[DEL]\033[0m  claude mcp removed: $name"
            fi
        fi
    done <<<"$existing"

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name url helper client_id callback_port desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        url="$(jq -r '.url' <<<"$entry")"
        helper="$(jq -r '.claude_headers_helper // empty' <<<"$entry")"
        client_id="$(jq -r '.oauth.client_id // empty' <<<"$entry")"
        callback_port="$(jq -r '.oauth.callback_port // empty' <<<"$entry")"
        [ -n "$helper" ] && helper="${helper//__MISE_SHIMS__/$MISE_SHIMS}"

        desired_spec="$(jq -cnS \
            --arg url "$url" \
            --arg cid "$client_id" \
            --arg cp "$callback_port" \
            --arg h "$helper" '
            {type: "http", url: $url}
            + (if $cid != "" then {oauth: ({clientId: $cid} + (if $cp != "" then {callbackPort: ($cp | tonumber)} else {} end))} else {} end)
            + (if $h != "" then {headersHelper: $h} else {} end)
        ')"

        if claude_mcp_unchanged "$claude_cfg" "$name" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m claude mcp (http): $name (unchanged)"
            continue
        fi

        if in_list "$name" "$existing"; then
            run_with_timeout "$AI_SYNC_TIMEOUT" claude mcp remove --scope user "$name" &>/dev/null || true
        fi

        if [ -n "$helper" ]; then
            local json_payload
            json_payload="$(jq -n --arg url "$url" --arg h "$helper" '{type: "http", url: $url, headersHelper: $h}')"
            if run_cmd "claude mcp (http): $name" claude mcp add-json --scope user "$name" "$json_payload"; then
                echo -e "  \033[1;32m[SYNC]\033[0m claude mcp (http): $name"
            fi
        else
            local -a oauth_args=()
            [ -n "$client_id" ] && oauth_args+=(--client-id "$client_id")
            [ -n "$callback_port" ] && oauth_args+=(--callback-port "$callback_port")
            if run_cmd "claude mcp (http): $name" claude mcp add --transport http --scope user ${oauth_args[@]+"${oauth_args[@]}"} "$name" "$url"; then
                echo -e "  \033[1;32m[SYNC]\033[0m claude mcp (http): $name"
            fi
        fi
    done < <(jq -c '.mcp.http // [] | .[] | select((.agents // []) | index("claude"))' "$MANIFEST")

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name cmd cmd_path env_json desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        cmd="$(jq -r '.command' <<<"$entry")"
        env_json="$(jq -c '.env // {}' <<<"$entry")"

        if ! cmd_path="$(command -v "$cmd")"; then
            echo -e "  \033[1;31m[ERROR]\033[0m $cmd not found, skipping claude mcp: $name" >&2
            FAIL_COUNT=$((FAIL_COUNT + 1))
            continue
        fi

        desired_spec="$(build_stdio_spec "stdio" "$cmd_path" "$(jq -c '.args // []' <<<"$entry")" "$env_json")"

        if claude_mcp_unchanged "$claude_cfg" "$name" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m claude mcp (stdio): $name (unchanged)"
            continue
        fi

        local -a env_args=() arg_list=()
        while IFS= read -r -d '' item; do env_args+=("$item"); done < <(build_env_args "-e" "$env_json")
        while IFS= read -r a; do [ -n "$a" ] && arg_list+=("$a"); done < <(jq -r '.args // [] | .[]' <<<"$entry")

        if in_list "$name" "$existing"; then
            run_with_timeout "$AI_SYNC_TIMEOUT" claude mcp remove --scope user "$name" &>/dev/null || true
        fi
        if run_cmd "claude mcp (stdio): $name" claude mcp add "$name" --scope user "${env_args[@]}" -- "$cmd_path" ${arg_list[@]+"${arg_list[@]}"}; then
            echo -e "  \033[1;32m[SYNC]\033[0m claude mcp (stdio): $name"
        fi
    done < <(jq -c '.mcp.stdio // [] | .[] | select((.agents // []) | index("claude"))' "$MANIFEST")
}

# =============================================================================
# Antigravity (agy)
# =============================================================================
sync_agy_plugins() {
    echo -e "\n\033[1;36m[INFO]\033[0m Syncing Antigravity (agy) plugins..."
    local import_claude
    import_claude="$(jq -r '.plugins.agy.import_from_claude // false' "$MANIFEST")"
    if [ "$import_claude" = "true" ]; then
        if run_cmd "agy plugin import claude" agy plugin import claude; then
            echo -e "  \033[1;32m[SYNC]\033[0m agy plugin import claude"
        fi
    fi

    local desired existing
    desired="$(jq -r '
        (if (.plugins.agy.import_from_claude // false) then (.plugins.claude.install // []) else [] end)
        + (.plugins.agy.install // [])
        | map(., sub("@.*$"; ""))
        | unique | .[]
    ' "$MANIFEST")"
    existing="$(run_with_timeout "$AI_SYNC_TIMEOUT" agy plugin list --json 2>/dev/null | jq -r '
        if type == "array" then .[] | (.id // .name // empty)
        elif type == "object" then (.plugins // [])[] | (.id // .name // empty)
        else empty end
    ' 2>/dev/null || true)"

    while IFS= read -r plugin; do
        [ -z "$plugin" ] && continue
        if ! in_list "$plugin" "$desired"; then
            if run_cmd "agy plugin uninstall: $plugin" agy plugin uninstall "$plugin"; then
                echo -e "  \033[1;31m[DEL]\033[0m  agy plugin uninstalled: $plugin"
            fi
        fi
    done <<<"$existing"

    while IFS= read -r plugin; do
        [ -z "$plugin" ] && continue
        if ! in_list "$plugin" "$existing" && ! in_list "${plugin%%@*}" "$existing"; then
            if run_cmd "agy plugin install: $plugin" agy plugin install "$plugin"; then
                echo -e "  \033[1;32m[ADD]\033[0m  agy plugin installed: $plugin"
            fi
        fi
    done < <(jq -r '.plugins.agy.install // [] | .[]' "$MANIFEST")
}

agy_mcp_unchanged() {
    local agy_cfg="$1"
    local name="$2"
    local mode="$3"
    local desired_spec="$4"
    [ -r "$agy_cfg" ] || return 1
    local current_spec
    if [ "$mode" = "http" ]; then
        current_spec="$(jq -cS --arg n "$name" '.mcpServers[$n] // empty | {url: (.url // .serverUrl // "")}' "$agy_cfg" 2>/dev/null || true)"
    else
        current_spec="$(jq -cS --arg n "$name" '.mcpServers[$n] // empty | {command: .command, args: (.args // []), env: (.env // {})}' "$agy_cfg" 2>/dev/null || true)"
    fi
    [ -n "$current_spec" ] && [ "$current_spec" = "$desired_spec" ]
}

sync_agy_mcp() {
    echo -e "\n\033[1;36m[INFO]\033[0m Syncing Antigravity (agy) MCP servers..."
    local desired existing agy_cfg
    desired="$(desired_mcp_names agy)"
    existing="$(run_with_timeout "$AI_SYNC_TIMEOUT" agy mcp list 2>/dev/null | awk 'NR>1 {print $1}' || true)"
    agy_cfg="$HOME/.gemini/config/mcp_config.json"

    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if ! in_list "$name" "$desired"; then
            if run_cmd "agy mcp remove: $name" agy mcp remove "$name"; then
                echo -e "  \033[1;31m[DEL]\033[0m  agy mcp removed: $name"
            fi
        fi
    done <<<"$existing"

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name url desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        url="$(jq -r '.url' <<<"$entry")"
        desired_spec="$(jq -cnS --arg url "$url" '{url: $url}')"
        if agy_mcp_unchanged "$agy_cfg" "$name" "http" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m agy mcp (http): $name (unchanged)"
            continue
        fi
        if run_cmd "agy mcp (http): $name" agy mcp add --type http "$name" "$url"; then
            echo -e "  \033[1;32m[SYNC]\033[0m agy mcp (http): $name"
        fi
    done < <(jq -c '.mcp.http // [] | .[] | select((.agents // []) | index("agy"))' "$MANIFEST")

    while IFS= read -r entry; do
        [ -z "$entry" ] && continue
        local name cmd cmd_path env_json desired_spec
        name="$(jq -r '.name' <<<"$entry")"
        cmd="$(jq -r '.command' <<<"$entry")"
        env_json="$(jq -c '.env // {}' <<<"$entry")"

        if ! cmd_path="$(command -v "$cmd")"; then
            echo -e "  \033[1;31m[ERROR]\033[0m $cmd not found, skipping agy mcp: $name" >&2
            FAIL_COUNT=$((FAIL_COUNT + 1))
            continue
        fi

        desired_spec="$(build_stdio_spec "" "$cmd_path" "$(jq -c '.args // []' <<<"$entry")" "$env_json")"
        if agy_mcp_unchanged "$agy_cfg" "$name" "stdio" "$desired_spec"; then
            echo -e "  \033[1;33m[SKIP]\033[0m agy mcp (stdio): $name (unchanged)"
            continue
        fi

        local -a env_args=() arg_list=()
        while IFS= read -r -d '' item; do env_args+=("$item"); done < <(build_env_args "-e" "$env_json")
        while IFS= read -r a; do [ -n "$a" ] && arg_list+=("$a"); done < <(jq -r '.args // [] | .[]' <<<"$entry")

        if run_cmd "agy mcp (stdio): $name" agy mcp add "${env_args[@]}" "$name" -- "$cmd_path" ${arg_list[@]+"${arg_list[@]}"}; then
            echo -e "  \033[1;32m[SYNC]\033[0m agy mcp (stdio): $name"
        fi
    done < <(jq -c '.mcp.stdio // [] | .[] | select((.agents // []) | index("agy"))' "$MANIFEST")
}

# =============================================================================
# Codex CLI
# =============================================================================
sync_codex_config() {
    local apply_script="$HOME/dotfiles/ai/codex/apply_config.py"
    [ -f "$apply_script" ] || return 0
    if ! command -v python3 &>/dev/null; then
        echo -e "  \033[1;33m[SKIP]\033[0m python3 not found, skipping codex config merge."
        return 0
    fi
    echo -e "\n\033[1;36m[INFO]\033[0m Merging Codex shared config..."
    local -a args=()
    $DRY_RUN && args+=(--dry-run)
    python3 "$apply_script" ${args[@]+"${args[@]}"}
}

