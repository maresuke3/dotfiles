#!/usr/bin/env bash
#MISE description="Run health checks on dotfiles (symlinks, age key, tools, JSON, zsh startup)"
set -euo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

DOTFILES_DIR="${HOME}/dotfiles"
OS_NAME="$(uname -s)"
FAIL_COUNT=0
WARN_COUNT=0

ok()   { echo -e "  \033[1;32m[OK]\033[0m   $*"; }
warn() { echo -e "  \033[1;33m[WARN]\033[0m $*"; WARN_COUNT=$((WARN_COUNT + 1)); }
fail() { echo -e "  \033[1;31m[FAIL]\033[0m $*"; FAIL_COUNT=$((FAIL_COUNT + 1)); }

# -----------------------------------------------------------------------------
# 1. Symlinks check
# -----------------------------------------------------------------------------
echo -e "\033[1;36m[1/5]\033[0m Checking symlinks..."

check_symlink() {
    local target="$1"
    local expected_source="$2"

    if [ -L "$target" ]; then
        if [ ! -e "$target" ]; then
            fail "Broken symlink: $target -> $(readlink "$target")"
        else
            local actual
            actual="$(readlink "$target")"
            if [ "$actual" = "$expected_source" ]; then
                ok "$target"
            else
                warn "$target points to $actual (expected $expected_source)"
            fi
        fi
    elif [ -e "$target" ]; then
        warn "$target exists as a regular file/dir (not a symlink)"
    else
        fail "Missing symlink: $target (expected -> $expected_source)"
    fi
}

while read -r target source; do
    [ -z "$target" ] && continue
    if [[ "$target" == mac:* ]]; then
        [[ "$OS_NAME" == "Darwin" ]] || continue
        target="${target#mac:}"
    elif [[ "$target" == linux:* ]]; then
        [[ "$OS_NAME" == "Linux" ]] || continue
        target="${target#linux:}"
    fi

    target="${target/#\~/$HOME}"
    source="${source/#\~/$HOME}"
    check_symlink "$target" "$source"
done < <(grep -E '^\s*".*"\s*=\s*\{\s*source' "$DOTFILES_DIR/mise/conf.d/symlinks.toml" | awk -F'"' '{print $2, $4}')

check_symlink "$HOME/.config/mise" "$DOTFILES_DIR/mise"

# -----------------------------------------------------------------------------
# 2. Age identity key check
# -----------------------------------------------------------------------------
echo -e "\n\033[1;36m[2/5]\033[0m Checking age identity key..."

AGE_KEY="$HOME/.config/mise/dotfiles-age.txt"
if [ -f "$AGE_KEY" ]; then
    if [[ "$OS_NAME" == "Darwin" ]]; then
        perm="$(stat -f '%Lp' "$AGE_KEY" 2>/dev/null || echo "")"
    else
        perm="$(stat -c '%a' "$AGE_KEY" 2>/dev/null || echo "")"
    fi
    if [ "$perm" = "600" ]; then
        ok "$AGE_KEY (mode 600)"
    elif [ -n "$perm" ]; then
        warn "$AGE_KEY has mode $perm (recommended: 600)"
    else
        warn "Could not inspect permissions of $AGE_KEY"
    fi
else
    warn "Age identity file not found at $AGE_KEY (secrets decryption skipped)"
fi

# -----------------------------------------------------------------------------
# 3. Core & AI CLI availability
# -----------------------------------------------------------------------------
echo -e "\n\033[1;36m[3/5]\033[0m Checking CLI tools..."

for cmd in mise git zsh jq age rg fd nvim yazi sheldon starship; do
    if command -v "$cmd" &>/dev/null; then
        ok "$cmd ($(command -v "$cmd"))"
    else
        fail "Missing core tool: $cmd"
    fi
done

for cmd in gh claude agy codex serena; do
    if command -v "$cmd" &>/dev/null; then
        ok "$cmd ($(command -v "$cmd"))"
    else
        warn "Optional/AI tool not found: $cmd"
    fi
done

# -----------------------------------------------------------------------------
# 4. Config / JSON validation
# -----------------------------------------------------------------------------
echo -e "\n\033[1;36m[4/5]\033[0m Validating config files..."

if command -v jq &>/dev/null; then
    for f in \
        "$DOTFILES_DIR/ai/ai-sync.json" \
        "$DOTFILES_DIR/ai/claude/settings.json" \
        "$DOTFILES_DIR/ai/gemini/settings.json" \
        "$DOTFILES_DIR/ai/gemini/mcp_config.json"
    do
        [ -f "$f" ] || continue
        if jq empty "$f" &>/dev/null; then
            ok "Valid JSON: ${f#"$DOTFILES_DIR/"}"
        else
            fail "Invalid JSON: ${f#"$DOTFILES_DIR/"}"
        fi
    done
else
    warn "jq not found; skipping JSON validation"
fi

# -----------------------------------------------------------------------------
# 5. Zsh startup benchmark
# -----------------------------------------------------------------------------
echo -e "\n\033[1;36m[5/5]\033[0m Measuring Zsh startup time..."

if command -v zsh &>/dev/null; then
    startup_ms="$(zsh -c 'zmodload zsh/datetime; t=$EPOCHREALTIME; zsh -i -c exit 2>/dev/null; printf "%.0f\n" $(( (EPOCHREALTIME - t) * 1000 ))' 2>/dev/null || echo "")"
    if [ -n "$startup_ms" ]; then
        if [ "$startup_ms" -le 300 ]; then
            ok "zsh -i -c exit: ${startup_ms}ms"
        else
            warn "zsh -i -c exit: ${startup_ms}ms (slower than 300ms)"
        fi
    else
        warn "Could not measure zsh startup time"
    fi
else
    fail "zsh not found"
fi

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
echo -e "\n\033[1;34m=== Doctor Summary ===\033[0m"
echo -e "  Failures: $FAIL_COUNT, Warnings: $WARN_COUNT"

if [ "$FAIL_COUNT" -gt 0 ]; then
    exit 1
fi
