# appearance
## font
font-family = Cica
font-family = FiraCode Nerd Font
font-family = Fira Code
font-size = 18
font-thicken = true
adjust-cell-height = 2

## theme
theme = TokyoNight Moon
background-opacity = 0.7

## padding
# 余白は WezTerm の window_padding (10) に合わせる。割り切れない端数の余白は上下左右に振り分ける
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# window
# 終了時にウィンドウ・タブ・分割・作業ディレクトリを保存し、次回起動時に復元する
window-save-state = always

# tab
keybind = ctrl+t=new_tab

# pane 
## move
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+l=goto_split:right
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up

## select mode
# Ctrl+Shift+H でペイン操作モードに入り、h/j/k/l で続けて移動、z でズームする。Enter (選択完了) か Esc で抜ける
# モード中はほかのキーを無視する (catch_all=ignore)
# モードはペインごとに持つため、all: で全ペインのモードを同時に切り替え、移動先でもモードが続くようにする
keybind = all:ctrl+shift+h=activate_key_table:pane
keybind = pane/h=goto_split:left
keybind = pane/j=goto_split:down
keybind = pane/k=goto_split:up
keybind = pane/l=goto_split:right
keybind = pane/z=toggle_split_zoom
keybind = pane/all:enter=deactivate_key_table
keybind = pane/all:escape=deactivate_key_table
keybind = pane/catch_all=ignore

## create
keybind = alt+d=new_split:right
keybind = alt+shift+d=new_split:down

## zoom
keybind = ctrl+shift+z=toggle_split_zoom
# 分割を最大化したまま goto_split で移動したとき、最大化を解除せず移動先を最大化する
split-preserve-zoom = navigation

# quick terminal
# どのアプリからでも Ctrl+` で画面上部に端末を出し入れする (macOS のアクセシビリティ権限が必要)
keybind = global:ctrl+backquote=toggle_quick_terminal

# keyboard
# 左 Option を Alt として扱う (ABC 配列では既定で Alt にならない)。右 Option は特殊文字の入力用に残す
macos-option-as-alt = left

# clipboard
copy-on-select = true
clipboard-read = allow
clipboard-write = allow

# shell integration
# ssh 先が xterm-ghostty を知らなくても表示が崩れないようにする
# (リモートに terminfo を入れ、失敗したら TERM=xterm-256color で接続する)
shell-integration-features = ssh-env,ssh-terminfo

# notification
notify-on-command-finish = unfocused
